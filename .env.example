# Copy to .env.local. Every value is optional in development.
# See DEVELOPMENT_SETUP.md for what each one does.

# --- Database -----------------------------------------------------------------
# Local development needs nothing here: it uses a SQLite file (./data/skyline.db).
# Production uses PostgreSQL and MUST set DATABASE_URL (in the host's settings,
# never in a tracked file). See DEPLOYMENT.md.
#   DATABASE_URL            pooled connection string, used by the running site
#   DATABASE_URL_UNPOOLED   direct connection string, used by the db:* and admin:create commands
# DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.example.neon.tech/DBNAME?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST.example.neon.tech/DBNAME?sslmode=require

# Where the local SQLite file lives (default: ./data/skyline.db). Local development only.
# SKYLINE_DB_PATH=/var/lib/skyline/skyline.db

# The club's real UPI ID, for the payment QR code on the join page. Leave unset
# and no QR code is shown. Scanning the code never verifies a payment.
# SKYLINE_UPI_ID=yourclub@bank
# SKYLINE_UPI_PAYEE=Skyline Student Association

# Where uploaded payment screenshots are stored (default: ./data/uploads)
# SKYLINE_UPLOAD_DIR=/var/lib/skyline/uploads

# Online membership payment through Razorpay (TEST MODE ONLY in this version).
# Leave these unset and the join page offers only the manual form.
# Put real values in .env.local, which Git ignores. Never put them in this file.
#   SKYLINE_RAZORPAY_MODE     must be exactly `test`; `live` is refused
#   SKYLINE_RAZORPAY_KEY_ID   a test Key ID (starts rzp_test_); live keys are refused
#   SKYLINE_RAZORPAY_KEY_SECRET      the matching Key Secret; server-side only
#   SKYLINE_RAZORPAY_WEBHOOK_SECRET  the secret you typed when creating the webhook;
#                                    needed only for /api/webhooks/razorpay
# SKYLINE_RAZORPAY_MODE=test
# SKYLINE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# SKYLINE_RAZORPAY_KEY_SECRET=replace-with-your-test-key-secret
# SKYLINE_RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret

# Show the demo sign-ins on /login when running a production build.
# SKYLINE_DEMO_MODE=1

# Display settings (compiled into the browser bundle; rebuild after changing).
# NEXT_PUBLIC_CURRENCY=INR
# NEXT_PUBLIC_LOCALE=en-IN
# NEXT_PUBLIC_ORG_TZ=Asia/Kolkata
# NEXT_PUBLIC_MEMBERSHIP_FEE_CENTS=50000
